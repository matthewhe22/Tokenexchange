# Postgres (Supabase or Neon). Use the POOLED url here for serverless functions...
DATABASE_URL=postgres://user:pass@host:6543/postgres
# ...and the direct url for migrations/seed (optional, falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/postgres

# 32 random bytes, base64. Encrypts upstream credentials at rest. Never change it after channels exist.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# At least 32 random characters; signs admin session cookies.
SESSION_SECRET=

# Used once by `npm run db:seed` to create the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Postgres connections per function instance.
DB_POOL_MAX=5
