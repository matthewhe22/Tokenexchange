# Postgres (Supabase or Neon). Use the POOLED url here for serverless functions...
DATABASE_URL=postgres://user:pass@host:6543/postgres
# ...and the direct url for migrations/seed (optional, falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/postgres

# 32 random bytes, base64. Encrypts upstream credentials at rest. Never change it after channels exist.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# At least 32 random characters; signs admin session cookies.
SESSION_SECRET=

# Used once by `npm run db:seed` to create the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Postgres connections per function instance.
DB_POOL_MAX=5

# Public URL used in emails, Stripe redirects, code samples and metadata. Defaults to the Vercel production URL.
# The canonical domain is https://mytenon.com (see README "Custom domain").
APP_URL=https://mytenon.com

# --- Stripe (top-ups). Without STRIPE_SECRET_KEY the billing page shows "payments not enabled". ---
STRIPE_SECRET_KEY=sk_live_or_test_...
# From the webhook endpoint you create at <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email via Resend (verification + password reset). Without it, emails are logged
# and new accounts are treated as verified. ---
RESEND_API_KEY=
EMAIL_FROM=Tenon <noreply@mytenon.com>

# --- Cloudflare Turnstile bot protection on sign-up / password reset (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret Vercel Cron sends to /api/cron/release-reservations (any random string).
CRON_SECRET=

# --- Rate limiting (optional). Without these, counters are kept in Postgres. ---
# The Vercel Marketplace "Upstash for Redis" integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sign in with GitHub / Google (optional; buttons appear when both id and secret are set) ---
# Callback URLs to register: <APP_URL>/api/auth/github/callback and <APP_URL>/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Time zone for dates shown in the app and for "today" / daily totals (IANA name). Default: Australia/Melbourne.
APP_TIMEZONE=Australia/Melbourne

# --- Optional: price benchmark on the admin Models page. Defaults to OpenRouter's public list. ---
# BENCHMARK_MODELS_URL=https://openrouter.ai/api/v1/models
